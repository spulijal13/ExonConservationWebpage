[Unit]
Description=Hertel Lab exon conservation browser
After=network.target postgresql.service

[Service]
Type=simple
User=hertellab
Group=hertellab
WorkingDirectory=/home/hertellab/exon-conservation/app
EnvironmentFile=/home/hertellab/exon-conservation/.env.prod
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/hertellab/exon-conservation/.venv/bin/gunicorn --config /home/hertellab/exon-conservation/deploy/gunicorn.conf.py exon.wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exon-conservation

[Install]
WantedBy=multi-user.target
