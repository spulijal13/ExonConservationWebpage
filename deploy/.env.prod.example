# Copy to /home/hertellab/exon-conservation/.env.prod; chmod 600.
# Simple KEY=value syntax works with systemd and the shell preparation commands.
SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_KEY
DEBUG=false
DJANGO_ALLOWED_HOSTS=hexevent.mmg.uci.edu,localhost,127.0.0.1
DJANGO_SCRIPT_NAME=/exons
DJANGO_TRUST_PROXY=true
DJANGO_CSRF_TRUSTED_ORIGINS=https://hexevent.mmg.uci.edu
# Apache already provides HTTPS. False also permits private SSH-tunnel checks.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_STATIC_ROOT=/var/www/exon-conservation/static
SQL_ENGINE=django.db.backends.postgresql
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DATABASE=exon_conservation
SQL_USER=exon_conservation
SQL_PASSWORD=REPLACE_WITH_A_NEW_DATABASE_PASSWORD
